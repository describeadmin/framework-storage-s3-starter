<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    本 POM 【不继承 framework-parent】—— 与 framework-cache-redis-starter 同一个理由，
    不重复。插件对框架的关系与业务方完全相同：import framework-bom 拿版本仲裁，
    自带一份精简构建配置。下面这些配置都是【硬约束】而非偏好，对应 CLAUDE.md 的具体条款，
    不要"精简"掉：
      - release=17                产物必须能跑在 Java 17 上
      - enforcer 的 requireJavaVersion  唯一构建前提：JDK >= 17
      - surefire 的 UTF-8         中文 Windows 上默认 GBK，断言里的中文会对不上（CLAUDE.md 3.6）
      - enforcer 的两条 ban       JDBC 驱动、Jackson 3
    【不带】framework 仓里的 enforce-core-thin —— 本模块的职责就是引入 AWS S3 SDK。
  -->

  <groupId>io.github.describeadmin</groupId>
  <artifactId>framework-storage-s3-starter</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>

  <name>describeadmin :: framework-storage-s3-starter</name>
  <description>把 StorageProvider 切换到 S3 / S3 兼容对象存储（MinIO、RustFS、阿里云 OSS 的 S3 网关等）的可选插件</description>
  <url>https://github.com/describeadmin/framework-storage-s3-starter</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>describeadmin</id>
      <name>describeadmin</name>
      <url>https://github.com/describeadmin</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/describeadmin/framework-storage-s3-starter.git</connection>
    <developerConnection>scm:git:git@github.com:describeadmin/framework-storage-s3-starter.git</developerConnection>
    <url>https://github.com/describeadmin/framework-storage-s3-starter</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 见 framework-cache-redis-starter 的同段注释：release=17 这一行不能删。 -->
    <maven.compiler.release>17</maven.compiler.release>
    <enforcer.java.version>[17,)</enforcer.java.version>

    <!--
      ⚠️ 本插件构建所针对的框架版本。必须与
      FrameworkStorageS3AutoConfiguration.REQUIRED_FRAMEWORK_VERSION 对得上 ——
      那个常量运行期自检读，这个属性构建期解析用。CI 兼容性矩阵靠覆盖它来跑：
          mvn -B test -Ddescribeadmin.version=0.3.0
      插件自身版本号（上面的 <version>）与本属性【不联动】。
    -->
    <describeadmin.version>0.2.0</describeadmin.version>

    <!-- AWS SDK for Java v2。Spring Boot 不仲裁它，必须自己 import BOM。 -->
    <aws-sdk.version>2.54.9</aws-sdk.version>

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <central-publishing-plugin.version>0.11.0</central-publishing-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 业务方的姿势：只 import framework-bom，不写任何框架模块的版本号。 -->
      <dependency>
        <groupId>io.github.describeadmin</groupId>
        <artifactId>framework-bom</artifactId>
        <version>${describeadmin.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        AWS SDK v2 的 BOM。仲裁 s3、url-connection-client 以及它们一大票传递依赖
        （auth / regions / http-client-spi / json-utils …）的版本，避免版本漂移。
      -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      契约模块用 compile：插件的全部意义是提供 StorageProvider 的另一种实现，
      这个接口必须在运行时存在。它只依赖 spring-boot-autoconfigure，传递过去没有负担。
    -->
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-storage-starter</artifactId>
    </dependency>

    <!--
      FrameworkVersion 在 framework-common 里，而 framework-storage-starter 【不】传递依赖它。
      cache-redis 是靠 provided 的 security-starter 把 framework-common 带上测试 classpath 的，
      那条链路很脆（换个依赖组合就断）。这里显式声明 compile，保证启动期自检永远可用。
      模块很小（版本自检 + 少量 DTO），BOM 已仲裁版本，不会与业务方已有的产生冲突。
    -->
    <dependency>
      <groupId>io.github.describeadmin</groupId>
      <artifactId>framework-common</artifactId>
    </dependency>

    <!--
      AWS S3 SDK。默认会拖进 apache-client + netty-nio-client 两个 HTTP 实现，
      两个同时在 classpath 上 SDK 会直接报 "Multiple HTTP implementations found"。
      这里都排掉，换成 url-connection-client —— 基于 JDK 的 HttpURLConnection，
      零额外传递依赖，对"上传/下载单个对象"这类用法完全够用。
      需要连接池吞吐的业务方可自行排掉本依赖、换 apache-client，并注册自己的 S3Client Bean
      （插件的 @ConditionalOnMissingBean 会让位）。
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <exclusions>
        <!--
          s3 默认会拖进一个同步 HTTP 实现（2.54 起是 apache5-client → httpclient5，
          更早是 apache-client → httpclient4），有的版本还带 netty-nio-client。
          全部排掉，只保留下面显式声明的 url-connection-client —— 两个实现同时在
          classpath 上，SDK 会在建 client 时抛 "Multiple HTTP implementations found"。
        -->
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      同仓时期由 framework-parent 的 <dependencies> 白送，独立成仓后必须自己声明。
      拆仓最容易漏这类"继承来的隐式依赖"。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      测试用真实的 S3 兼容服务（Testcontainers MinIO），不用 mock：
      本模块的价值全在"与真实 S3 语义一致"—— 预签名 URL 能不能被 HTTP 拉到、
      path-style 寻址、NoSuchKey 的错误码，mock 掉就等于把要验证的部分假设成立。
      版本由 spring-boot-dependencies 传递来的 testcontainers-bom 仲裁。
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>minio</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <!-- 测试 JVM 必须显式 UTF-8，否则中文 Windows 上默认 GBK，断言对不上。CLAUDE.md 3.6 -->
          <argLine>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</argLine>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>${enforcer.java.version}</version>
                  <message>
                    构建本插件需要 JDK 17 或更高版本（用 `mvn -v` 查看 Maven 实际使用的 JDK）。
                    具体用 17 / 21 / 25 都可以，产物一律是 Java 17 字节码。
                  </message>
                </requireJavaVersion>
                <!-- 插件同样不得引入 JDBC 驱动。CLAUDE.md 3.4，拆仓后不再从父 POM 继承。 -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.mysql:mysql-connector-j</exclude>
                    <exclude>mysql:mysql-connector-java</exclude>
                    <exclude>org.mariadb.jdbc:mariadb-java-client</exclude>
                    <exclude>com.oceanbase:oceanbase-client</exclude>
                    <exclude>com.dameng:*</exclude>
                    <exclude>cn.com.kingbase:*</exclude>
                  </excludes>
                  <message>
                    框架与插件均不得依赖任何 JDBC 驱动。驱动由业务方在自己的 pom.xml 中声明。
                  </message>
                </bannedDependencies>
                <!-- Jackson 3（tools.jackson.*）属于 Spring Boot 4.x 生态，本项目锁 Jackson 2.x。 -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>tools.jackson.core:*</exclude>
                  </excludes>
                  <message>
                    本项目锁定 Jackson 2.x（com.fasterxml.jackson.*）。tools.jackson.* 是 Jackson 3。
                  </message>
                </bannedDependencies>
                <!--
                  只保留一个 AWS HTTP 实现。apache-client / netty-nio-client 已在依赖里排除，
                  这条规则兜住"有人手滑又把它加回来"—— 两个同时在 classpath 上，
                  SDK 启动即抛 "Multiple HTTP implementations found"，且报错不指向 pom。
                -->
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>software.amazon.awssdk:apache5-client</exclude>
                    <exclude>software.amazon.awssdk:apache-client</exclude>
                    <exclude>software.amazon.awssdk:netty-nio-client</exclude>
                  </excludes>
                  <message>
                    本插件固定使用 url-connection-client 作为唯一的 AWS HTTP 实现。
                    多个实现同时在 classpath 上，AWS SDK 会在启动时抛
                    "Multiple HTTP implementations found"。
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 发布 profile。与 framework 仓 / 其它插件的同名 profile 一致。步骤见 docs 仓 RELEASE.md。 -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
